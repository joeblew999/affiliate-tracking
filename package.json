{
  "name": "cloudflare-durable-streams",
  "version": "0.1.0",
  "private": true,
  "description": "Durable Streams for Cloudflare: the full protocol, with subscriptions, on D1 read replicas. A Void app that any Worker, local or deployed, writes to and follows.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joeblew999/cloudflare-durable-streams.git"
  },
  "type": "module",
  "exports": {
    "./client": "./client.ts",
    "./bus": "./bus.ts"
  },
  "scripts": {
    "dev": "vp dev",
    "postinstall": "void prepare",
    "typecheck": "tsc && tsc -p test",
    "check:types": "vp run --filter './**' --parallel typecheck",
    "db:migrate": "void db migrate",
    "db:generate": "void db generate"
  },
  "dependencies": {
    "@durable-streams/client": "0.2.7",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@durable-streams/server-conformance-tests": "0.3.7",
    "@types/node": "26.6.6",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "void": "catalog:",
    "wrangler": "^4.166.0"
  },
  "packageManager": "pnpm@12.18.0"
}
