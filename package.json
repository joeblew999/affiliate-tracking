{
  "name": "cloudflare-durable-streams",
  "version": "0.1.0",
  "private": true,
  "description": "Durable Streams for Cloudflare: the full protocol, with subscriptions, on D1 read replicas. A Void app that any Worker, local or deployed, writes to and follows.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joeblew999/cloudflare-durable-streams.git"
  },
  "type": "module",
  "exports": {
    "./client": "./client.ts",
    "./bus": "./bus.ts"
  },
  "scripts": {
    "dev": "vp dev",
    "postinstall": "void prepare",
    "typecheck": "tsc && tsc -p test",
    "check:types": "vp run --filter './**' --parallel typecheck",
    "db:migrate": "void db migrate",
    "db:generate": "void db generate"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@better-auth/api-key": "1.7.27",
    "@durable-streams/client": "0.2.7",
    "@fontsource-variable/geist": "5.3.0",
    "better-auth": "catalog:",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "hono": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shadcn": "4.23.0",
    "tw-animate-css": "1.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@durable-streams/server-conformance-tests": "0.3.7",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@void/react": "catalog:",
    "tailwindcss": "4.3.5",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "void": "catalog:",
    "wrangler": "^4.166.0"
  },
  "packageManager": "pnpm@12.18.0"
}
