{
  "extends": "./.void/tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "lib": ["ES2025", "DOM", "DOM.Iterable"],
    "types": ["void/env"]
  },
  "include": [
    "src",
    "routes",
    "crons",
    "durable-objects",
    "middleware",
    "db",
    "scripts",
    "pages",
    "*.ts"
  ]
}
