{
  // The tests type-check against the affiliate service itself: its path aliases, and Void's
  // generated route types (.void/routes.d.ts), so a call's path, params, body and answer all come
  // from the service's routes. Its middleware is included for the context variables it declares
  // (CloudContextVariables), so the service's code means here what it means in the service.
  "extends": "../apps/affiliates/tsconfig.json",
  "compilerOptions": {
    "types": ["node", "void/env"]
  },
  "include": ["**/*.ts", "../apps/affiliates/middleware"]
}
